{
  "name": "oiticicas-digital",
  "version": "1.0.0",
  "description": "OITICICAS DIGITAL — plataforma SaaS de cardápio digital, PDV, delivery e gestão para restaurantes",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js && node scripts/copy-assets.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo": "npm run demo:seed && DATABASE_URL=${DEMO_DATABASE_URL:-mysql://od:od123@127.0.0.1:3306/oiticicas_demo} DEMO_MODE=true node dist/server.js",
    "typecheck": "tsc -p .",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}

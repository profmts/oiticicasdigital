# ===== OITICICAS DIGITAL — variáveis de ambiente =====

# ---------- Banco de dados MySQL (Hostinger: Websites → Painel → Bancos de dados → Gerenciamento) ----------
# Opção 1 (recomendada): variáveis separadas. Na Hostinger o host costuma ser "localhost".
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_oiticicas
DB_USER=u000000000_oiticicas
DB_PASSWORD=
# Opção 2: uma única URL (se a senha tiver caracteres especiais, prefira a opção 1)
# DATABASE_URL=mysql://usuario:senha@localhost:3306/banco
# true só se o servidor MySQL exigir SSL (bancos externos)
DATABASE_SSL=false
DATABASE_POOL=5

# Código exigido para criar o primeiro administrador da plataforma em /plataforma/entrar.
# Gere um valor longo e aleatório. Obrigatório em produção.
SETUP_TOKEN=

PORT=3000
NODE_ENV=production
# Em produção com HTTPS: true
COOKIE_SECURE=true
# Atrás de proxy (Hostinger, Caddy, Nginx): true
TRUST_PROXY=true
SESSION_DAYS=7

# Cria automaticamente a empresa Espetinho do Sergio com o cardápio oficial na primeira execução
SEED_ESPETINHO=true
PLATFORM_NAME=OITICICAS DIGITAL

# Demonstração (avisos de dados fictícios). Não use em produção.
DEMO_MODE=false

# ---------- Somente para VPS com docker-compose ----------
DOMAIN=
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_PASSWORD=troque-esta-senha
